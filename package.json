{
  "name": "@lvce-editor/real-time-collaboration-prototype-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node packages/server/scripts/patch-server.ts",
    "build": "npm run build --workspace=packages/build",
    "start": "node packages/server/src/server.ts",
    "test": "npm test --workspace=packages/collaboration",
    "typecheck": "npm run typecheck --workspace=packages/collaboration",
    "test:e2e": "npm test --workspace=packages/e2e",
    "benchmark": "npm run benchmark --workspace=packages/benchmark"
  }
}
